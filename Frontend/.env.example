# Optional: override the backend base URL.
# By default the Vite dev server proxies /auth and /api to http://localhost:8080
# (see vite.config.ts) so you can leave VITE_API_BASE_URL empty for development.
# For production builds, set this to your backend public URL, e.g.
# VITE_API_BASE_URL=https://api.stockflow.example.com
VITE_API_BASE_URL=
