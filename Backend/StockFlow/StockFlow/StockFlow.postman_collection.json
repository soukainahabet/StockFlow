{
  "info": {
    "name": "StockFlow API",
    "description": "Collection complete pour tester l'API StockFlow (Spring Boot + JWT). Importe aussi l'environnement StockFlow.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwt", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@stockflow.com\",\n  \"password\": \"secret123\",\n  \"roleName\": \"USER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('jwt', res.data.token);",
                  "  console.log('JWT saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@stockflow.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('jwt', res.data.token);",
                  "  console.log('JWT saved: ' + res.data.token.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories (paginated + search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories?page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name,asc" },
                { "key": "name", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get category by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories/1", "host": ["{{baseUrl}}"], "path": ["api", "categories", "1"] }
          }
        },
        {
          "name": "Create category (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Beverages\"\n}" }
          }
        },
        {
          "name": "Update category (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/categories/1", "host": ["{{baseUrl}}"], "path": ["api", "categories", "1"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Boissons\"\n}" }
          }
        },
        {
          "name": "Delete category (ADMIN)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/categories/1", "host": ["{{baseUrl}}"], "path": ["api", "categories", "1"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products (paginated + filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name,asc" },
                { "key": "name", "value": "", "disabled": true },
                { "key": "categoryId", "value": "", "disabled": true },
                { "key": "minPrice", "value": "", "disabled": true },
                { "key": "maxPrice", "value": "", "disabled": true },
                { "key": "lowStock", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
          }
        },
        {
          "name": "Products by category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/category/1?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "category", "1"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Low stock products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/low-stock", "host": ["{{baseUrl}}"], "path": ["api", "products", "low-stock"] }
          }
        },
        {
          "name": "Create product (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coca-Cola 33cl\",\n  \"price\": 1.50,\n  \"quantity\": 100,\n  \"alertThreshold\": 10,\n  \"categoryId\": 1\n}"
            }
          }
        },
        {
          "name": "Update product (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coca-Cola 33cl\",\n  \"price\": 1.75,\n  \"quantity\": 200,\n  \"alertThreshold\": 20,\n  \"categoryId\": 1\n}"
            }
          }
        },
        {
          "name": "Delete product (ADMIN)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "List sales (paginated + filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sales?page=0&size=20&sort=date,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "date,desc" },
                { "key": "userId", "value": "", "disabled": true },
                { "key": "startDate", "value": "2026-04-01T00:00:00", "disabled": true },
                { "key": "endDate", "value": "2026-04-30T23:59:59", "disabled": true },
                { "key": "minTotal", "value": "", "disabled": true },
                { "key": "maxTotal", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get sale by id (with items)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/sales/1", "host": ["{{baseUrl}}"], "path": ["api", "sales", "1"] }
          }
        },
        {
          "name": "Recent sales",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sales/recent?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales", "recent"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Create sale",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/sales", "host": ["{{baseUrl}}"], "path": ["api", "sales"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 3 },\n    { \"productId\": 2, \"quantity\": 1 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Delete sale",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/sales/1", "host": ["{{baseUrl}}"], "path": ["api", "sales", "1"] }
          }
        }
      ]
    },
