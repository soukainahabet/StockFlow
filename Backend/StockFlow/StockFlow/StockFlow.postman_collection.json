                { "key": "productId", "value": "", "disabled": true },
                { "key": "userId", "value": "", "disabled": true },
                { "key": "type", "value": "IN", "disabled": true },
                { "key": "startDate", "value": "", "disabled": true },
                { "key": "endDate", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get movement by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/stock-movements/1", "host": ["{{baseUrl}}"], "path": ["api", "stock-movements", "1"] }
